# ARM64 Build stage optimized for Raspberry Pi 4
FROM arm64v8/node:20-slim AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies - Alpine has smaller footprint
RUN npm install --legacy-peer-deps

# Copy source code
COPY . .

# Build TypeScript
RUN npm run build

# Production stage - minimal ARM64 runtime
FROM arm64v8/node:20-alpine AS production

WORKDIR /app

# Install only essential dependencies for Puppeteer on ARM64 (minimal set)
# Chromium on RPi can be resource-intensive, so we use a lightweight approach
RUN apk add --no-cache \
    chromium \
    noto-sans \
    --no-cache

# Use system Chromium to save resources
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Copy package files
COPY package*.json ./

# Install production dependencies only
RUN npm install --omit=dev --legacy-peer-deps

# Copy built files from builder
COPY --from=builder /app/dist ./dist

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Change ownership
RUN chown -R nodejs:nodejs /app

USER nodejs

# Expose port
EXPOSE 3001

# Set environment variables for performance
ENV NODE_ENV=production
ENV PORT=3001

# Start the application
CMD ["node", "dist/index.js"]
