# ARM64 Build stage optimized for Raspberry Pi 4
FROM arm64v8/node:20-slim AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy source code
COPY . .

# Build TypeScript
RUN npm run build

# Production stage - Debian-slim base
FROM arm64v8/node:20-slim AS production

WORKDIR /app

# Install minimal dependencies
# Note: We skip Chromium for RPi to save disk/memory
# PriceGhost has 3 other extraction methods that work without JavaScript rendering
RUN apt-get update && apt-get install -y \
    ca-certificates \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Skip Chromium download - Puppeteer will gracefully degrade for RPi
# Other extraction methods (JSON-LD, CSS, AI) don't need it
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Copy package files
COPY package*.json ./

# Install production dependencies only
RUN npm install --omit=dev --legacy-peer-deps

# Copy built files from builder
COPY --from=builder /app/dist ./dist

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Change ownership
RUN chown -R nodejs:nodejs /app

USER nodejs

# Expose port
EXPOSE 3001

# Set environment variables for performance
ENV NODE_ENV=production
ENV PORT=3001

# Start the application
CMD ["node", "dist/index.js"]
