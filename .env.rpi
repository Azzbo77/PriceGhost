# PriceGhost Environment Variables for Raspberry Pi + Remote Ollama
# Copy this as .env and fill in your values

# ================================================================
# DATABASE CONFIGURATION
# ================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=priceghost

# ================================================================
# BACKEND CONFIGURATION
# ================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=change_me_to_a_random_secret

# Backend port (inside container)
PORT=3001

# Node.js environment
NODE_ENV=production

# Memory optimization for Pi (1.5GB out of 4GB)
NODE_OPTIONS=--max-old-space-size=1536

# ================================================================
# REMOTE OLLAMA CONFIGURATION (CRITICAL FOR YOUR SETUP!)
# ================================================================
# Replace 192.168.1.100 with your powerful server's IP address
# This is where the actual AI inference happens
OLLAMA_BASE_URL=http://192.168.1.100:11434

# Model to use (must be already pulled on your Ollama server)
# Options: mistral, neural-chat, qwen2, orca-mini
OLLAMA_MODEL=mistral

# ================================================================
# FRONTEND CONFIGURATION
# ================================================================
# API endpoint for frontend to connect to (from browser perspective)
VITE_API_URL=/api

# ================================================================
# OPTIONAL: ADVANCED SETTINGS
# ================================================================
# Timeout for Ollama requests (in milliseconds)
# Increase if your server is slow or doing other work
# OLLAMA_REQUEST_TIMEOUT=120000

# Database connection pool size
# Lower for Pi (default 10, RPi should be 2-5)
# DATABASE_POOL_SIZE=3

# Log level (debug, info, warn, error)
# LOG_LEVEL=info

# ================================================================
# NOTIFICATION SERVICES (OPTIONAL - Configure in Web UI)
# ================================================================
# These can also be set per-user in the web interface:

# Telegram
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# Discord
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Pushover
# PUSHOVER_USER_KEY=your_user_key
# PUSHOVER_APP_TOKEN=your_app_token

# ntfy.sh (free push notification service)
# NTFY_TOPIC=priceghost_alerts
# NTFY_SERVER_URL=https://ntfy.sh

# ================================================================
# INSTRUCTIONS
# ================================================================
# 1. Replace the placeholders with your actual values
# 2. Most importantly: Set OLLAMA_BASE_URL to your server's IP
# 3. Make sure the model name matches what you pulled on Ollama
# 4. Save this file as .env in the same directory as docker-compose.rpi.yml
# 5. Run: docker-compose -f docker-compose.rpi.yml up -d --build

# ================================================================
# SECURITY REMINDERS
# ================================================================
# - NEVER commit .env to git (it's already in .gitignore)
# - Use a strong POSTGRES_PASSWORD
# - Generate JWT_SECRET with: openssl rand -base64 32
# - Don't share your Ollama server's IP publicly
# - Consider using firewall rules to restrict Ollama access

# ================================================================
# TESTING YOUR CONFIGURATION
# ================================================================
# From Raspberry Pi, test Ollama connectivity:
# curl http://YOUR_SERVER_IP:11434/api/tags
#
# Should return a JSON list of available models
# If it fails, check:
# 1. Server IP is correct
# 2. Ollama is running (systemctl status ollama on server)
# 3. OLLAMA_HOST is set to 0.0.0.0:11434 on server
# 4. Firewall allows port 11434
